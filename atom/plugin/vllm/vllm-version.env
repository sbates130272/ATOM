# The vLLM this branch targets. Sourced by .github/scripts/plugin_ci and by
# the accuracy, benchmark and release workflows, so the two original keys keep
# their names and meaning.
VLLM_COMMIT=4ba787ec9959e566d3b587a796dff07673324da5
VLLM_VERSION=0.33.0

# The range the plugin's compat layer claims. Read by
# atom/plugin/vllm/_compat.py, which logs once -- non-fatally -- when the
# running vLLM falls outside it, and by tests that assert the two agree.
#
# MIN is the commit ATOM v0.1.9 itself targeted (db9527a4, 0.31.0); the
# relocation table in _compat.py still carries that version's symbol homes, so
# nothing here drops support for it.
#
# TESTED_MAX is raised only after `python -m atom.plugin.vllm.compat_check` is
# clean against the new version AND `python -m atom.plugin.vllm.doctor` reports
# no unexplained stand-down on it. See UPGRADING-VLLM.md.
VLLM_SUPPORTED_MIN=0.31.0
VLLM_TESTED_MAX=0.33.0
